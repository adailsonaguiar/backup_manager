# Apenas configurações não secretas; copie para .env e ajuste.
PGHOST=postgres.example.com
PGPORT=5432
PGDATABASE=app
PGUSER=backup
BACKUP_NAME=app

# Para banco com CA privada, use compose.ca.yaml e configure verify-full.
PGSSLMODE=require
# PGSSLROOTCERT=/run/backup-ca/ca-certificate.crt
PGCONNECT_TIMEOUT=15

S3_BUCKET=meu-bucket
AWS_REGION=sa-east-1
