# Senha global usada como fallback para todos os bancos.
PGPASSWORD=senha_geral

# Senha específica por banco (opcional, sobrescreve a global).
# O nome deve estar em MAIÚSCULAS, com hífens/underscores normalizados.
PGPASSWORD_FINANCEIRO=senha_financeiro
PGPASSWORD_CURSOS=senha_cursos
PGPASSWORD_USUARIOS=senha_usuarios
